# Insurance PoC V2.0 environment template
# (Named .env.v2.example because .env.example is a copied V1 file that must not be modified.
#  Copy these keys into your project-root .env to configure the V2 stack.)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro
EMBEDDING_MODEL=models/gemini-embedding-001
DUCKDB_PATH=D:\Projects\CLD Projects\Insurance PoC - V2.0\database\insurance_v2.duckdb
LANCEDB_PATH=D:\Projects\CLD Projects\Insurance PoC - V2.0\lance_store
API_PORT=3001
MAX_CONTEXT_TOKENS=6000
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_TTL_HOURS=24
EMBEDDING_DELAY_SECONDS=0.1
