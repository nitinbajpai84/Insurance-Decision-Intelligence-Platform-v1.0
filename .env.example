# Supabase Postgres connection string.
# Use the pooled connection string for large jobs if available.
SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Provider: gemini, openai, compatible, local
EMBEDDING_PROVIDER=gemini

# Gemini provider for text generation and embeddings.
GEMINI_API_KEY=your_google_api_key_here
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# OpenAI provider
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# OpenAI-compatible or Claude-compatible gateway provider.
# Use this for vendors/proxies that expose an OpenAI-style /embeddings endpoint.
COMPATIBLE_API_KEY=
COMPATIBLE_BASE_URL=https://your-compatible-gateway.example/v1
COMPATIBLE_EMBEDDING_MODEL=your-embedding-model

# Local provider. Requires: pip install sentence-transformers
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Pipeline behavior
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MAX_ROWS=0
EMBEDDING_RETRY_ATTEMPTS=5
EMBEDDING_RETRY_BASE_SECONDS=1.0
EMBEDDING_DRY_RUN=false

# Must match public.semantic_documents.embedding vector dimension.
# Current MVP uses Gemini embeddings at 768 dimensions to match public.semantic_documents.embedding vector(768).
EMBEDDING_DIMENSIONS=768

# Primary LLM provider for copilot generation.
LLM_PROVIDER=gemini
GEMINI_MODEL_SQL=gemini-2.5-flash-lite
GEMINI_MODEL_FAST=gemini-2.5-flash-lite

# Initial testing timeout and future target.
LLM_TIMEOUT_SECONDS=120
TARGET_RESPONSE_TIME_SECONDS=5

# Legacy text-to-SQL generation provider: openai, compatible, mock.
# Kept for backward compatibility. The copilot gateway uses LLM_PROVIDER when set.
TEXT2SQL_PROVIDER=compatible
TEXT2SQL_MODEL=gemini-2.5-flash-lite
TEXT2SQL_API_KEY=
TEXT2SQL_BASE_URL=
TEXT2SQL_TEMPERATURE=0

# Query execution controls
TEXT2SQL_ROW_LIMIT=500
TEXT2SQL_STATEMENT_TIMEOUT_MS=5000
TEXT2SQL_SEMANTIC_MATCH_COUNT=8
TEXT2SQL_SEMANTIC_THRESHOLD=0.0

# Comma-separated schemas the generated SQL may read.
TEXT2SQL_ALLOWED_SCHEMAS=public
