# Committed default so the frontend works out of the box when opened from a
# cloud IDE (StackBlitz/WebContainer, CodeSandbox) with no local setup.
#
# Next.js env precedence: .env.local  >  .env
# So local development is unaffected — frontend_v2/.env.local (gitignored,
# pointing at http://127.0.0.1:3001) overrides this file automatically.
#
# ONLY put non-secret values here. NEXT_PUBLIC_* vars are compiled into the
# browser bundle and are public by definition. Never add API keys to this file.

NEXT_PUBLIC_API_V2_URL=https://meridian-insurance-backend-786480520780.asia-southeast1.run.app
